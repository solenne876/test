# Clé API Anthropic — nécessaire pour générer les tunnels (recherche web +
# rédaction du tunnel). Créez-la sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# Port d'écoute du serveur (optionnel, 3000 par défaut)
PORT=3000

# Protège l'interface interne (surface 1) par un mot de passe (Basic Auth).
# Recommandé dès que l'outil est déployé sur une URL publique — sans ces deux
# variables, l'interface interne reste ouverte à qui a l'URL. Le lien
# questionnaire public (/q/<slug>) n'est jamais concerné par cette protection.
INTERNAL_BASIC_AUTH_USER=
INTERNAL_BASIC_AUTH_PASS=

# Intégration Gmail en lecture seule (optionnelle). Sans ces 3 variables,
# l'outil continue de fonctionner en ignorant simplement cette source.
# Voir README.md pour la procédure de création des identifiants OAuth2
# (Google Cloud Console, scope https://www.googleapis.com/auth/gmail.readonly).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
